HILI_API_HOST=0.0.0.0
HILI_API_PORT=4141
HILI_DATA_DIR=./app-data
HILI_SCAN_INTERVAL_MS=900000
# 监听媒体文件变化并在约 1.5 秒后增量触发全量校准；设为 false 可关闭
HILI_WATCH_MEDIA=true
# 宿主机媒体根目录，挂载到容器的 /media（Docker 部署用）
HILI_MEDIA_ROOT=/media
HILI_FFMPEG_PATH=
HILI_FFPROBE_PATH=
# 目录浏览白名单（/fs/roots、/fs/list），逗号分隔的容器内路径。
# 不设置时 /fs/list 可枚举整机文件系统（Windows 下是 A:-Z: 全盘），
# 异地组网场景建议显式限制；compose 里已注入 /media。
# HILI_FS_ROOTS=/media
# 额外放行的跨域来源（逗号分隔）。默认只放行回环与私有网段（含 100.64.0.0/10）。
# HILI_ALLOWED_ORIGINS=
# ─ HLS 远程播放产物（异地访问用）────────────────────────────────
# 源码率超过该值（kbps）才重编码降码率，否则直接切片（零 CPU、无损）。默认 8000
# HILI_HLS_MAX_BITRATE=8000
# 切片缓存上限（字节），超出按最久未播放淘汰。默认 20GB
# HILI_HLS_MAX_BYTES=21474836480
# 转码并发。默认 1，别调太高以免占满 NAS 的 CPU
# HILI_TRANSCODE_CONCURRENCY=1
# 编码器。留空自动探测（h264_qsv 优先，失败回退 libx264）
# HILI_HLS_ENCODER=
# 每次扫描补货的预热任务数，0 关闭预热
# HILI_HLS_WARMUP=12
# 孤儿缓存文件保留天数（未被引用的缓存/临时文件超过该天数才清理）
# HILI_CACHE_PRUNE_DAYS=30
# 安全演示模式由 pnpm dev:safe 自动配置：
# HILI_TEST_MODE=1
# HILI_ALLOWED_MEDIA_ROOT=./.hilihili-safe-demo/safe-demo-library
# 服务端渲染时访问 API 的地址；浏览器端会自动从当前页面 host 推导
# Docker 部署时通常使用 compose 服务名：http://api:4141
NEXT_PUBLIC_API_BASE_URL=http://localhost:4141
